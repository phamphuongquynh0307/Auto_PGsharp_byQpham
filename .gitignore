# Python
.venv/
__pycache__/
*.pyc

# PyInstaller build output (regenerable, and the exe is ~100MB)
build/
dist/
dist-new/
/dist-guide*/
*.spec.bak

# Runtime / scratch
settings.json
settings.json.bak
screenshot.png
catch_screen.png
_*.png
# Per-cycle phase breakdown written when CatchConfig.trace_timing is on.
timing*.log
# Always-on diagnostic log (avc/diag.py) and the support zips exported from it.
autoclick.log*
baocao-*.zip
# Screens the stall watchdog could not read, kept so a stuck run can be reported
# after the fact instead of having to be caught happening.
stuck/

