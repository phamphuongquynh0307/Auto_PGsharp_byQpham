{
  "manifest_version": 3,
  "name": "PoGo Radar — Qpham",
  "version": "0.3.7",
  "description": "Tự Search PoGo Coordinates, lọc Stats và IV/PvPoke, báo trên web và Discord.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "power"
  ],
  "host_permissions": [
    "https://pogocoordinates.com/*",
    "https://raw.githubusercontent.com/pvpoke/pvpoke/*",
    "https://discord.com/api/webhooks/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "PoGo Radar",
    "default_popup": "panel.html"
  },
  "options_page": "panel.html",
  "content_scripts": [
    {
      "matches": [
        "https://pogocoordinates.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
